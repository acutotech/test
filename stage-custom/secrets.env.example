# Copy to stage-custom/secrets.env (git-ignored). Plain VAR=value lines, bash
# syntax: quote values that contain spaces or special characters.
#
# Read by scripts/build-local.sh (FIRST_USER_PASS, PUBKEY_SSH_FIRST_USER go into
# the pi-gen config) and by the custom stage (WIFI_*). In GitHub Actions the
# workflow generates this file from repository secrets instead.

# Password of the first user. Set it for a headless device. pi-gen cannot handle
# " $ ` or \ in it; anything else is fine.
FIRST_USER_PASS='change-me'

# authorized_keys content for the first user (one key per line is fine).
PUBKEY_SSH_FIRST_USER='ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@laptop'

# Wi-Fi network written to /boot/firmware/network-config.
WIFI_SSID='My Network'
WIFI_PASSWORD='wifi-passphrase'
