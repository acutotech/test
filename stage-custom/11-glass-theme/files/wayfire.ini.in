# Genesis Glass session: Wayfire 0.9 with background blur, animations and
# shadows on top of the Raspberry Pi desktop (wf-panel-pi, pcmanfm desktop).
# Edit with: Genesis Settings > Appearance, or "wcm" (Wayfire Config Manager).

[core]
plugins = alpha animate autostart blur command decoration expo fast-switcher foreign-toplevel grid gtk-shell idle move oswitch place resize session-lock shortcuts-inhibit switcher vswitch wayfire-shell window-rules wm-actions wobbly zoom @EXTRA_PLUGINS@
xwayland = true
preferred_decoration_mode = server
close_top_view = <super> KEY_Q | <alt> KEY_F4

[autostart]
autostart_wf_shell = false
panel = wf-panel-pi
background = pcmanfm --desktop
xdg = /usr/bin/genesis-xdg-autostart
portal = /usr/libexec/xdg-desktop-portal
outputs = kanshi

[blur]
method = kawase
kawase_degrade = 3
kawase_iterations = 2
kawase_offset = 2.0
saturation = 1.0
blur_by_default = type is "panel" | app_id is "lxterminal" | app_id is "wf-panel-pi" | app_id is "genesis-settings"
toggle = <super> KEY_B

[decoration]
font = Inter Medium 10
title_height = 30
border_size = 1
button_order = minimize maximize close
active_color = \#121c2bee
inactive_color = \#0d141ecc

[winshadows]
shadow_radius = 36
shadow_color = \#00000080
include_undecorated_views = false
glow_enabled = false

[animate]
open_animation = zoom
close_animation = zoom
duration = 220
startup_duration = 500
fade_duration = 180
zoom_duration = 220

[wobbly]
friction = 3.5
spring_k = 8.0
mass = 60.0

[expo]
toggle = <super> KEY_E
background = \#0b1420ff

[switcher]
next_view = <alt> KEY_TAB
prev_view = <alt> <shift> KEY_TAB

[fast-switcher]
activate = <alt> KEY_ESC

[grid]
slot_l = <super> KEY_LEFT
slot_r = <super> KEY_RIGHT
slot_c = <super> KEY_UP
restore = <super> KEY_DOWN

[wm-actions]
toggle_fullscreen = <super> KEY_F
toggle_maximize = <super> KEY_M
minimize = <super> KEY_H

[zoom]
modifier = <super>
speed = 0.01

[idle]
screensaver_timeout = -1
dpms_timeout = -1

[input]
xkb_model = pc105
xkb_layout = @XKB_LAYOUT@
cursor_theme = PiXtrix
cursor_size = 24
natural_scroll = false
tap_to_click = true

[command]
binding_terminal = <ctrl> <alt> KEY_T
command_terminal = lxterminal
binding_menu = <super>
command_menu = wfpanelctl smenu menu
binding_settings = <super> KEY_I
command_settings = genesis-settings
binding_files = <super> KEY_D
command_files = pcmanfm
binding_browser = <super> KEY_W
command_browser = x-www-browser
binding_screenshot = KEY_SYSRQ
command_screenshot = sh -c 'grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png'
binding_screenshot_area = <shift> KEY_SYSRQ
command_screenshot_area = sh -c 'grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png'
repeatable_binding_volume_up = KEY_VOLUMEUP
command_volume_up = wfpanelctl volumepulse volu
repeatable_binding_volume_down = KEY_VOLUMEDOWN
command_volume_down = wfpanelctl volumepulse vold
binding_mute = KEY_MUTE
command_mute = wfpanelctl volumepulse mute
binding_bluetooth = <ctrl> <alt> KEY_B
command_bluetooth = wfpanelctl bluetooth menu
binding_netman = <ctrl> <alt> KEY_W
command_netman = wfpanelctl netman menu
binding_quit = <ctrl> <alt> KEY_DELETE
command_quit = pishutdown
binding_power = KEY_POWER
command_power = pwrkey

[window-rules]
rule_terminal_alpha = on created if app_id is "lxterminal" then set alpha 0.92
