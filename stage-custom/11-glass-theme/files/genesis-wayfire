#!/bin/sh
# Genesis Glass session launcher: Wayfire with the Genesis configuration.
# Mirrors Raspberry Pi's labwc-pi/wayfire-pi wrappers so XWayland, Qt and the
# Pi environment helpers behave the same way.

if [ -f /usr/bin/setup_env ]; then
	# shellcheck disable=SC1091
	. /usr/bin/setup_env
fi

export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export DESKTOP_SESSION=genesis-glass
export XDG_CURRENT_DESKTOP=wayfire:LXDE
export XAUTHORITY="$HOME/.Xauthority"
if [ -x /usr/bin/xwayland-xauth ]; then
	export WLR_XWAYLAND=/usr/bin/xwayland-xauth
fi

CONFIG="$HOME/.config/wayfire.ini"
if [ ! -f "$CONFIG" ]; then
	mkdir -p "$HOME/.config"
	cp /etc/wayfire/genesis.ini "$CONFIG"
fi

if command -v raspi-config > /dev/null 2>&1 && ! raspi-config nonint is_pi; then
	export WLR_NO_HARDWARE_CURSORS=1
fi

exec /usr/bin/wayfire -c "$CONFIG" "$@"
