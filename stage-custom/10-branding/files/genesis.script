// Genesis OS Plymouth theme: the logo frame scaled to fit the screen on black.
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

splash.image = Image("splash.png");
scale_x = screen_width / splash.image.GetWidth();
scale_y = screen_height / splash.image.GetHeight();
scale = Math.Min(scale_x, scale_y);
splash.scaled = splash.image.Scale(splash.image.GetWidth() * scale, splash.image.GetHeight() * scale);
splash.sprite = Sprite(splash.scaled);
splash.sprite.SetX((screen_width - splash.scaled.GetWidth()) / 2);
splash.sprite.SetY((screen_height - splash.scaled.GetHeight()) / 2);
splash.sprite.SetZ(1);

// Password prompt (encrypted volumes) and messages, kept minimal.
fun display_password_callback(prompt, bullets) {
    message.image = Image.Text("Password: " + prompt, 0.86, 0.9, 0.94);
    message.sprite = Sprite(message.image);
    message.sprite.SetPosition((screen_width - message.image.GetWidth()) / 2, screen_height * 0.86, 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_message_callback(text) {
    status.image = Image.Text(text, 0.6, 0.66, 0.74);
    status.sprite = Sprite(status.image);
    status.sprite.SetPosition((screen_width - status.image.GetWidth()) / 2, screen_height * 0.9, 2);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);

fun refresh_callback() {}
Plymouth.SetRefreshFunction(refresh_callback);
