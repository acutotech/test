# Auto detect text files and perform LF normalization
* text=auto

# pi-gen runs these with bash inside a Linux container: CRLF would break them.
*.sh          text eol=lf
config        text eol=lf
Makefile      text eol=lf
stage-custom/** text eol=lf

# Binary assets (listed after the stage-custom rule so they win): never normalise line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.gpg   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
